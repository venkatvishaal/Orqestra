# ================================================
# Aurora Scheduler API — Environment Variables
# Copy this to .env and fill in your values
# ================================================

# Database
DATABASE_URL=postgresql://aurora:aurora_secret@localhost:5432/aurora_db

# Redis
REDIS_URL=redis://:redis_secret@localhost:6379

# JWT (generate secure random values for production!)
JWT_SECRET=change_me_to_a_long_random_secret_in_production
JWT_REFRESH_SECRET=change_me_to_another_long_random_secret

# Server
PORT=3001
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Worker config (used by apps/worker)
WORKER_CONCURRENCY=5
POLL_INTERVAL_MS=500
HEARTBEAT_INTERVAL_MS=5000
HEARTBEAT_TTL_MS=15000
DRAIN_TIMEOUT_MS=30000
